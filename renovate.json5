{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Only rebase PRs when they have conflicts, not just for being behind
  "rebaseWhen": "conflicted",

  // Extend recommended defaults + SHA pinning for GitHub Actions
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],

  // Enable the beta pre-commit manager
  "pre-commit": {
    "enabled": true
  },

  // Preserve recommended exclusions and ignore generated Mise package metadata.
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**"
  ],

  "packageRules": [
    {
      "description": "Keep Python on the selected minor release",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.14(?:\\.|$)/"
    },
    {
      "description": "Changing the supported Python minimum is a manual decision",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },

    // After bumping a mise tool version, re-lock just that tool so mise.lock
    // stays in sync with mise.toml.
    {
      "matchManagers": ["mise"],
      "postUpgradeTasks": {
        "commands": ["mise lock {{{depName}}}"],
        "fileFilters": ["mise.lock"],
        "executionMode": "update"
      }
    },
    // Group lychee updates across mise and pre-commit to keep versions in sync.
    // The lychee pre-commit hook uses the mise-provided binary when available,
    // so mismatched versions would cause silent version drift.
    {
      "groupName": "lychee",
      "matchPackageNames": ["cargo:lychee", "lycheeverse/lychee"]
    }
  ]
}
